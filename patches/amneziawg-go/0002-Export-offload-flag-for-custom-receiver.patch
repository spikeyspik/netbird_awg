From: =?UTF-8?q?Zolt=C3=A1n=20Papp?= <zoltan.pmail@gmail.com>
Date: Wed, 30 Oct 2024 18:13:35 +0100
Subject: [PATCH] Export offload flag for custom receiver

---
 conn/bind_std.go          |  6 +++---
 conn/export.go            | 12 ++++++++++++
 conn/receiver_creator.go  |  2 +-
 conn/sticky_default.go    |  8 ++++----
 conn/sticky_linux.go      |  8 ++++----
 conn/sticky_linux_test.go | 18 +++++++++---------
 6 files changed, 33 insertions(+), 21 deletions(-)
 create mode 100644 conn/export.go

diff --git a/conn/bind_std.go b/conn/bind_std.go
index 4704343..f505954 100644
--- a/conn/bind_std.go
+++ b/conn/bind_std.go
@@ -73,7 +73,7 @@ func NewStdNetBind() Bind {
 				msgs := make([]ipv6.Message, IdealBatchSize)
 				for i := range msgs {
 					msgs[i].Buffers = make(net.Buffers, 1)
-					msgs[i].OOB = make([]byte, 0, StickyControlSize+gsoControlSize)
+					msgs[i].OOB = make([]byte, 0, stickyControlSize+gsoControlSize)
 				}
 				return &msgs
 			},
@@ -189,7 +189,7 @@ again:
 		}
 		if s.receiverCreator != nil {
 			// Todo: check if this still works
-			fns = append(fns, s.receiverCreator.CreateIPv4ReceiverFn(&s.msgsPool, v4pc, v4conn))
+			fns = append(fns, s.receiverCreator.CreateIPv4ReceiverFn(v4pc, v4conn, s.ipv4RxOffload, &s.msgsPool))
 		} else {
 			fns = append(fns, s.makeReceiveIPv4(v4pc, v4conn, s.ipv4RxOffload))
 		}
@@ -284,7 +284,7 @@ func (s *StdNetBind) receiveIP(
 		}
 		addrPort := msg.Addr.(*net.UDPAddr).AddrPort()
 		ep := &StdNetEndpoint{AddrPort: addrPort} // TODO: remove allocation
-		GetSrcFromControl(msg.OOB[:msg.NN], ep)
+		getSrcFromControl(msg.OOB[:msg.NN], ep)
 		eps[i] = ep
 	}
 	return numMsgs, nil
diff --git a/conn/export.go b/conn/export.go
new file mode 100644
index 0000000..8bc2bad
--- /dev/null
+++ b/conn/export.go
@@ -0,0 +1,12 @@
+package conn
+
+const (
+	UdpSegmentMaxDatagrams = udpSegmentMaxDatagrams
+)
+
+var (
+	SplitCoalescedMessages = splitCoalescedMessages
+	GetSrcFromControl      = getSrcFromControl
+
+	GetGSOSize = getGSOSize
+)
diff --git a/conn/receiver_creator.go b/conn/receiver_creator.go
index fd99148..17dfa23 100644
--- a/conn/receiver_creator.go
+++ b/conn/receiver_creator.go
@@ -8,5 +8,5 @@ import (
 )
 
 type ReceiverCreator interface {
-	CreateIPv4ReceiverFn(msgPool *sync.Pool, pc *ipv4.PacketConn, conn *net.UDPConn) ReceiveFunc
+	CreateIPv4ReceiverFn(pc *ipv4.PacketConn, conn *net.UDPConn, rxOffload bool, msgPool *sync.Pool) ReceiveFunc
 }
