-// StickyControlSize returns the recommended buffer size for pooling sticky
+// stickyControlSize returns the recommended buffer size for pooling sticky
 // offloading control data.
-const StickyControlSize = 0
+const stickyControlSize = 0
 
 const StdNetSupportsStickySockets = false
