+func (s *Server) restartAfterWakeWithBarrier() {
+	s.mutex.Lock()
+	if !s.clientRunning || s.actCancel == nil {
+		s.mutex.Unlock()
+		log.Info("skipping wake restart because agent is not running")
+		return
+	}
+	s.mutex.Unlock()
+
+	barrier, ok := s.installWakeRouteBarrier()
+	if !ok {
+		log.Warn("skipping wake restart because route killswitch barrier is unavailable")
+		return
+	}
+	if barrier != nil {
+		s.setWakeRouteBarrier(barrier)
+	}
+
+	s.mutex.Lock()
+	if !s.clientRunning || s.actCancel == nil {
+		s.mutex.Unlock()
+		log.Info("skipping wake restart because agent stopped before restart")
+		s.clearWakeRouteBarrier()
+		return
+	}
+
+	giveUpChan := s.clientGiveUpChan
+	s.actCancel()
+	s.mutex.Unlock()
+
+	if giveUpChan != nil {
+		select {
+		case <-giveUpChan:
+			log.Debug("previous client goroutine stopped after wake restart request")
+		case <-time.After(wakeRestartStopTimeout):
+			log.Warn("timeout waiting for previous client goroutine during wake restart")
+		}
+	}
+
+	ctx, cancel := context.WithTimeout(s.rootCtx, wakeRestartUpTimeout)
+	defer cancel()
+
+	if _, err := s.Up(ctx, &proto.UpRequest{}); err != nil {
+		log.Errorf("wake restart failed, keeping route killswitch barrier active: %v", err)
+		return
+	}
+
+	log.Info("wake restart completed")
+}
+
+func (s *Server) protectEngineRestartWithBarrier(reason string) bool {
+	s.mutex.Lock()
+	running := s.clientRunning && s.actCancel != nil
+	s.mutex.Unlock()
+
+	if !running {
+		log.Debugf("route killswitch barrier skipped for %s: agent is not running", reason)
+		return true
+	}
+
+	barrier, ok := s.installWakeRouteBarrier()
+	if !ok {
+		log.Warnf("route killswitch barrier unavailable for %s", reason)
+		return false
+	}
+	if barrier != nil {
+		s.setWakeRouteBarrier(barrier)
+	}
+	return true
+}
+
+func (s *Server) setWakeRouteBarrier(barrier wakeRouteBarrier) {
+	s.wakeBarrierMu.Lock()
+	s.wakeBarrierID++
+	s.wakeBarrier = barrier
+	s.wakeBarrierMu.Unlock()
+}
+
+func (s *Server) scheduleWakeRouteBarrierClear() {
+	s.wakeBarrierMu.Lock()
+	barrierID := s.wakeBarrierID
+	hasBarrier := s.wakeBarrier != nil
+	s.wakeBarrierMu.Unlock()
+
+	if !hasBarrier {
+		return
+	}
+
+	go func() {
+		timer := time.NewTimer(wakeBarrierClearDelay)
+		defer timer.Stop()
+
+		select {
+		case <-s.rootCtx.Done():
+			return
+		case <-timer.C:
+		}
+
+		s.clearWakeRouteBarrierIfCurrent(barrierID)
+	}()
+}
+
+func (s *Server) clearWakeRouteBarrier() {
+	s.wakeBarrierMu.Lock()
+	barrier := s.wakeBarrier
+	if barrier != nil {
+		s.wakeBarrierID++
+	}
+	s.wakeBarrier = nil
+	s.wakeBarrierMu.Unlock()
+
+	if barrier != nil {
+		barrier.Close()
+	}
+}
+
+func (s *Server) clearWakeRouteBarrierIfCurrent(barrierID uint64) {
+	s.wakeBarrierMu.Lock()
+	if s.wakeBarrierID != barrierID {
+		s.wakeBarrierMu.Unlock()
+		return
+	}
+	barrier := s.wakeBarrier
+	if barrier != nil {
+		s.wakeBarrierID++
+	}
+	s.wakeBarrier = nil
+	s.wakeBarrierMu.Unlock()
+
+	if barrier != nil {
+		barrier.Close()
+	}
+}
diff --git a/client/server/sleep_barrier_darwin.go b/client/server/sleep_barrier_darwin.go
new file mode 100644
index 000000000..bf36c5c84
--- /dev/null
+++ b/client/server/sleep_barrier_darwin.go
@@ -0,0 +1,111 @@
+//go:build darwin && !ios
+
+package server
+
+import (
+	"fmt"
+	"net/netip"
+	"os"
+	"os/exec"
+	"strings"
+
+	log "github.com/sirupsen/logrus"
+
+	"github.com/netbirdio/netbird/client/internal/peer"
+	"github.com/netbirdio/netbird/shared/management/domain"
+)
+
+const (
+	wakeBarrierAnchor = "com.apple/netbird_awg_killswitch"
+	wakeBarrierTable  = "netbird_awg_kill"
+)
+
+type pfWakeRouteBarrier struct{}
+
+func (pfWakeRouteBarrier) Close() {
+	if err := cleanupWakeRouteBarrierArtifacts(); err != nil {
+		log.Debugf("cleanup wake route killswitch barrier: %v", err)
+	}
+}
+
+func (s *Server) installWakeRouteBarrier() (wakeRouteBarrier, bool) {
+	prefixes := routeBarrierPrefixes(s.statusRecorder.GetResolvedDomainsStates(), s.statusRecorder.GetFullStatus().Peers)
+	if len(prefixes) == 0 {
+		return nil, true
+	}
+
+	rules := pfRules(prefixes)
+	file, err := os.CreateTemp("", "netbird-awg-pf-*.conf")
+	if err != nil {
+		log.Warnf("create wake route killswitch barrier rules: %v", err)
+		return nil, false
+	}
+	path := file.Name()
+	defer os.Remove(path)
+
+	if _, err := file.WriteString(rules); err != nil {
+		_ = file.Close()
+		log.Warnf("write wake route killswitch barrier rules: %v", err)
+		return nil, false
+	}
+	if err := file.Close(); err != nil {
+		log.Warnf("close wake route killswitch barrier rules: %v", err)
+		return nil, false
+	}
+
+	if err := exec.Command("pfctl", "-a", wakeBarrierAnchor, "-f", path).Run(); err != nil {
+		log.Warnf("install wake route killswitch barrier: %v", err)
+		return nil, false
+	}
+
+	log.Infof("installed wake route killswitch barrier for %d prefixes", len(prefixes))
+	return pfWakeRouteBarrier{}, true
+}
+
+func cleanupWakeRouteBarrierArtifacts() error {
+	if err := exec.Command("pfctl", "-a", wakeBarrierAnchor, "-F", "all").Run(); err != nil {
+		return fmt.Errorf("flush pf anchor %s: %w", wakeBarrierAnchor, err)
+	}
+	return nil
+}
+
+func routeBarrierPrefixes(states map[domain.Domain]peer.ResolvedDomainInfo, peers []peer.State) []netip.Prefix {
+	prefixes := make([]netip.Prefix, 0)
+	seen := make(map[netip.Prefix]struct{})
+	add := func(prefix netip.Prefix) {
+		if _, ok := seen[prefix]; ok {
+			return
+		}
+		seen[prefix] = struct{}{}
+		prefixes = append(prefixes, prefix)
+	}
+
+	for _, info := range states {
+		for _, prefix := range info.Prefixes {
+			add(prefix)
+		}
+	}
+	for _, peerState := range peers {
+		for network := range peerState.GetRoutes() {
+			prefix, err := netip.ParsePrefix(network)
+			if err != nil {
+				continue
+			}
+			add(prefix)
+		}
+	}
+	return prefixes
+}
+
+func pfRules(prefixes []netip.Prefix) string {
+	items := make([]string, 0, len(prefixes))
+	for _, prefix := range prefixes {
+		items = append(items, prefix.String())
+	}
+
+	return fmt.Sprintf("table <%s> persist {\n\t%s\n}\nblock drop out quick to <%s>\n",
+		wakeBarrierTable,
