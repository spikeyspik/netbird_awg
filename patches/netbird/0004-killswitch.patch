+		Name:   question.Name,
+		Rrtype: question.Qtype,
+		Class:  question.Qclass,
+		Ttl:    1,
+	}
+
+	resp := new(dns.Msg)
+	resp.SetReply(r)
+	switch question.Qtype {
+	case dns.TypeA:
+		resp.Answer = []dns.RR{&dns.A{
+			Hdr: header,
+			A:   net.IPv4zero,
+		}}
+	case dns.TypeAAAA:
+		resp.Answer = []dns.RR{&dns.AAAA{
+			Hdr:  header,
+			AAAA: net.IPv6zero,
+		}}
+	default:
+		return nil
+	}
+	return resp
+}
