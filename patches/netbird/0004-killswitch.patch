diff --git a/client/internal/routemanager/dnsinterceptor/handler.go b/client/internal/routemanager/dnsinterceptor/handler.go
index b784cc274..2b4022a7e 100644
--- a/client/internal/routemanager/dnsinterceptor/handler.go
+++ b/client/internal/routemanager/dnsinterceptor/handler.go
@@ -283,15 +283,50 @@ func (d *DnsInterceptor) ServeDNS(w dns.ResponseWriter, r *dns.Msg) {
 }
 
 func (d *DnsInterceptor) writeDNSError(w dns.ResponseWriter, r *dns.Msg, logger *log.Entry, reason string) {
-	logger.Warnf("failed to query upstream for domain=%s: %s", r.Question[0].Name, reason)
+	logger.Warnf("failed to query upstream for domain=%s: %s; returning sinkhole answer", r.Question[0].Name, reason)
 
-	resp := new(dns.Msg)
-	resp.SetRcode(r, dns.RcodeServerFailure)
+	resp := sinkholeResponse(r)
+	if resp == nil {
+		resp = new(dns.Msg)
+		resp.SetRcode(r, dns.RcodeServerFailure)
+	}
 	if err := w.WriteMsg(resp); err != nil {
 		logger.Errorf("failed to write DNS error response: %v", err)
 	}
 }
 
+func sinkholeResponse(r *dns.Msg) *dns.Msg {
+	if len(r.Question) == 0 {
+		return nil
+	}
+
+	question := r.Question[0]
+	header := dns.RR_Header{
+		Name:   question.Name,
+		Rrtype: question.Qtype,
+		Class:  question.Qclass,
+		Ttl:    1,
+	}
+
+	resp := new(dns.Msg)
+	resp.SetReply(r)
+	switch question.Qtype {
+	case dns.TypeA:
+		resp.Answer = []dns.RR{&dns.A{
+			Hdr: header,
+			A:   net.IPv4zero,
+		}}
+	case dns.TypeAAAA:
+		resp.Answer = []dns.RR{&dns.AAAA{
+			Hdr:  header,
+			AAAA: net.IPv6zero,
+		}}
+	default:
+		return nil
+	}
+	return resp
+}
