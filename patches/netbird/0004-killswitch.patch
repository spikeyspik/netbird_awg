+func (s *Server) installSleepBarrierIfRunning() {
+	s.mutex.Lock()
+	running := s.clientRunning && s.actCancel != nil
+	s.mutex.Unlock()
+	if !running {
+		log.Debug("sleep route killswitch barrier skipped because agent is not running")
+		return
+	}
+
+	if barrier, ok := s.installWakeRouteBarrier(); ok && barrier != nil {
+		s.setWakeRouteBarrier(barrier)
+	} else if !ok {
+		log.Warn("route killswitch barrier is unavailable during sleep transition")
+	}
+}
+
+func (s *Server) restartAfterWakeWithBarrier() {
+	s.mutex.Lock()
+	if !s.clientRunning || s.actCancel == nil {
+		s.mutex.Unlock()
+		log.Info("skipping wake restart because agent is not running")
+		s.clearWakeRouteBarrier()
+		return
+	}
+	s.mutex.Unlock()
+
+	s.wakeBarrierMu.Lock()
+	hasBarrier := s.wakeBarrier != nil
+	s.wakeBarrierMu.Unlock()
+	if !hasBarrier {
+		barrier, ok := s.installWakeRouteBarrier()
+		if !ok {
+			log.Warn("skipping wake restart because route killswitch barrier is unavailable")
+			return
+		}
+		if barrier != nil {
+			s.setWakeRouteBarrier(barrier)
+		}
+	}
+
+	s.mutex.Lock()
+	if !s.clientRunning || s.actCancel == nil {
+		s.mutex.Unlock()
+		log.Info("skipping wake restart because agent stopped before restart")
+		s.clearWakeRouteBarrier()
+		return
+	}
+
+	giveUpChan := s.clientGiveUpChan
+	s.actCancel()
+	s.mutex.Unlock()
+
+	if giveUpChan != nil {
+		select {
+		case <-giveUpChan:
+			log.Debug("previous client goroutine stopped after wake restart request")
+		case <-time.After(wakeRestartStopTimeout):
+			log.Warn("timeout waiting for previous client goroutine during wake restart")
+		}
+	}
+
+	ctx, cancel := context.WithTimeout(s.rootCtx, wakeRestartUpTimeout)
+	defer cancel()
+
+	if _, err := s.Up(ctx, &proto.UpRequest{}); err != nil {
+		log.Errorf("wake restart failed, keeping route killswitch barrier active: %v", err)
+		return
+	}
+
+	log.Info("wake restart completed")
+}
+
+func (s *Server) setWakeRouteBarrier(barrier wakeRouteBarrier) {
+	s.wakeBarrierMu.Lock()
+	oldBarrier := s.wakeBarrier
+	s.wakeBarrier = barrier
+	s.wakeBarrierMu.Unlock()
+
+	if oldBarrier != nil {
+		oldBarrier.Close()
+	}
+}
+
+func (s *Server) clearWakeRouteBarrier() {
+	s.wakeBarrierMu.Lock()
+	barrier := s.wakeBarrier
+	s.wakeBarrier = nil
+	s.wakeBarrierMu.Unlock()
+
+	if barrier != nil {
+		barrier.Close()
+	}
+}
diff --git a/client/server/sleep_barrier_darwin.go b/client/server/sleep_barrier_darwin.go
new file mode 100644
index 000000000..f9fdd7fe5
--- /dev/null
+++ b/client/server/sleep_barrier_darwin.go
@@ -0,0 +1,155 @@
+//go:build darwin && !ios
+
+package server
+
+import (
+	"fmt"
+	"net/netip"
+	"os"
+	"os/exec"
+	"strings"
+
+	log "github.com/sirupsen/logrus"
+)
+
+const (
+	wakeBarrierAnchor = "com.apple/netbird_awg_killswitch"
+	wakeBarrierTable  = "netbird_awg_kill"
+)
+
+type pfWakeRouteBarrier struct {
+	token string
+}
+
+func (s *Server) installWakeRouteBarrier() (wakeRouteBarrier, bool) {
+	prefixes := s.wakeBarrierPrefixes()
+	token, err := loadWakeBarrierPF(prefixes)
+	if err != nil {
+		log.Warnf("failed to install wake route killswitch barrier: %v", err)
+		return nil, false
+	}
+
+	log.Infof("installed wake route killswitch barrier for %d resolved domain route IP(s)", len(prefixes))
+	return &pfWakeRouteBarrier{token: token}, true
+}
+
+func (s *Server) wakeBarrierPrefixes() []netip.Prefix {
+	states := s.statusRecorder.GetResolvedDomainsStates()
+	seen := make(map[netip.Addr]struct{})
+	prefixes := make([]netip.Prefix, 0, len(states))
+
+	for _, state := range states {
+		for _, prefix := range state.Prefixes {
+			addr := prefix.Addr()
+			if !addr.IsValid() {
+				continue
+			}
+			if _, ok := seen[addr]; ok {
+				continue
+			}
+			seen[addr] = struct{}{}
+			if addr.Is4() {
+				prefixes = append(prefixes, netip.PrefixFrom(addr, 32))
+			} else {
+				prefixes = append(prefixes, netip.PrefixFrom(addr, 128))
+			}
+		}
+	}
+
+	return prefixes
+}
+
+func loadWakeBarrierPF(prefixes []netip.Prefix) (string, error) {
+	rules := buildWakeBarrierPFRules(prefixes)
+
+	file, err := os.CreateTemp("", "netbird-awg-wake-pf-*.conf")
+	if err != nil {
+		return "", fmt.Errorf("create pf rules file: %w", err)
+	}
+	defer func() {
+		if err := os.Remove(file.Name()); err != nil {
+			log.Debugf("remove temporary pf rules file: %v", err)
+		}
+	}()
+
+	if _, err := file.WriteString(rules); err != nil {
+		_ = file.Close()
+		return "", fmt.Errorf("write pf rules file: %w", err)
+	}
+	if err := file.Close(); err != nil {
+		return "", fmt.Errorf("close pf rules file: %w", err)
+	}
+
+	if out, err := exec.Command("pfctl", "-a", wakeBarrierAnchor, "-f", file.Name()).CombinedOutput(); err != nil {
+		return "", fmt.Errorf("load pf anchor: %w: %s", err, strings.TrimSpace(string(out)))
+	}
+
+	token, err := enablePFForWakeBarrier()
+	if err != nil {
+		_ = flushWakeBarrierPF()
+		return "", err
+	}
+
+	return token, nil
+}
+
+func buildWakeBarrierPFRules(prefixes []netip.Prefix) string {
+	var builder strings.Builder
+	addrs := make([]string, 0, len(prefixes))
+	for _, prefix := range prefixes {
+		addrs = append(addrs, prefix.Addr().String())
+	}
+
+	if len(addrs) > 0 {
+		_, _ = fmt.Fprintf(&builder, "table <%s> persist { %s }\n", wakeBarrierTable, strings.Join(addrs, ", "))
+		_, _ = fmt.Fprintf(&builder, "block drop out quick to <%s>\n", wakeBarrierTable)
+	}
+
+	// Block direct DNS while the agent is restarting. This covers classic DNS,
+	// DNS-over-TLS and DNS-over-QUIC. DoH over TCP/443 is indistinguishable from
+	// regular HTTPS at this layer and must be disabled by browser/MDM policy.
+	builder.WriteString("block drop out quick proto { tcp udp } to any port 53\n")
+	builder.WriteString("block drop out quick proto { tcp udp } to any port 853\n")
+	builder.WriteString("block drop out quick proto udp to any port 443\n")
+	return builder.String()
+}
+
+func enablePFForWakeBarrier() (string, error) {
+	out, err := exec.Command("pfctl", "-E").CombinedOutput()
+	if err != nil {
+		return "", fmt.Errorf("enable pf: %w: %s", err, strings.TrimSpace(string(out)))
+	}
+
+	for _, line := range strings.Split(string(out), "\n") {
+		if !strings.Contains(line, "Token") {
+			continue
+		}
+		fields := strings.Fields(line)
+		if len(fields) > 0 {
+			return fields[len(fields)-1], nil
+		}
+	}
+
+	return "", nil
+}
+
+func (b *pfWakeRouteBarrier) Close() {
+	if err := flushWakeBarrierPF(); err != nil {
+		log.Warnf("failed to clear wake route killswitch barrier: %v", err)
+	}
+
+	if b.token == "" {
+		return
+	}
+
+	if out, err := exec.Command("pfctl", "-X", b.token).CombinedOutput(); err != nil {
+		log.Debugf("failed to release pf token for wake route killswitch barrier: %v: %s", err, strings.TrimSpace(string(out)))
+	}
+}
+
+func flushWakeBarrierPF() error {
+	if out, err := exec.Command("pfctl", "-a", wakeBarrierAnchor, "-F", "all").CombinedOutput(); err != nil {
+		return fmt.Errorf("flush pf anchor: %w: %s", err, strings.TrimSpace(string(out)))
+	}
+	return nil
+}
