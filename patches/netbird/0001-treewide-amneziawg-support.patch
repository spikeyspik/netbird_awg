diff --git a/management/server/amneziawg/amneziawg_env.go b/management/server/amneziawg/amneziawg_env.go
new file mode 100644
index 000000000..ee18d31c7
--- /dev/null
+++ b/management/server/amneziawg/amneziawg_env.go
@@ -0,0 +1,167 @@
+package amneziawg
+
+import (
+	"encoding/base64"
+	"os"
+	"strconv"
+	"strings"
+)
+
+const (
+	envAmneziaJc                     = "NETBIRD_AMNEZIA_JC"
+	envAmneziaJmin                   = "NETBIRD_AMNEZIA_JMIN"
+	envAmneziaJmax                   = "NETBIRD_AMNEZIA_JMAX"
+	envAmneziaS1                     = "NETBIRD_AMNEZIA_S1"
+	envAmneziaS2                     = "NETBIRD_AMNEZIA_S2"
+	envAmneziaS3                     = "NETBIRD_AMNEZIA_S3"
+	envAmneziaS4                     = "NETBIRD_AMNEZIA_S4"
+	envAmneziaH1                     = "NETBIRD_AMNEZIA_H1"
+	envAmneziaH2                     = "NETBIRD_AMNEZIA_H2"
+	envAmneziaH3                     = "NETBIRD_AMNEZIA_H3"
+	envAmneziaH4                     = "NETBIRD_AMNEZIA_H4"
+	envAmneziaI1                     = "NETBIRD_AMNEZIA_I1"
+	envAmneziaI2                     = "NETBIRD_AMNEZIA_I2"
+	envAmneziaI3                     = "NETBIRD_AMNEZIA_I3"
+	envAmneziaI4                     = "NETBIRD_AMNEZIA_I4"
+	envAmneziaI5                     = "NETBIRD_AMNEZIA_I5"
+	envAmneziaRekeyAfterTime         = "NETBIRD_AMNEZIA_REKEY_AFTER_TIME"
+	envAmneziaRekeyTimeout           = "NETBIRD_AMNEZIA_REKEY_TIMEOUT"
+	envAmneziaRejectAfterTime        = "NETBIRD_AMNEZIA_REJECT_AFTER_TIME"
+	envAmneziaKeepaliveTimeout       = "NETBIRD_AMNEZIA_KEEPALIVE_TIMEOUT"
+	envAmneziaMaxHandshakeAttempts   = "NETBIRD_AMNEZIA_MAX_HANDSHAKE_ATTEMPTS"
+	envAmneziaContentPaddingAddition = "NETBIRD_AMNEZIA_CONTENT_PADDING_ADDITION"
+	envAmneziaHeaderProtectionKey    = "NETBIRD_AMNEZIA_HEADER_PROTECTION_KEY"
+)
+
+type StoreStruct struct {
+	Jc                        int32
+	Jmin                      int32
+	Jmax                      int32
+	S1                        int32
+	S2                        int32
+	S3                        uint32
+	S4                        uint32
+	H1Min                     uint32
+	H1Max                     uint32
+	H2Min                     uint32
+	H2Max                     uint32
+	H3Min                     uint32
+	H3Max                     uint32
+	H4Min                     uint32
+	H4Max                     uint32
+	I1                        string
+	I2                        string
+	I3                        string
+	I4                        string
+	I5                        string
+	RekeyAfterTimeMin         uint32
+	RekeyAfterTimeMax         uint32
+	RekeyTimeoutMin           uint32
+	RekeyTimeoutMax           uint32
+	RejectAfterTimeMin        uint32
+	RejectAfterTimeMax        uint32
+	KeepaliveTimeoutMin       uint32
+	KeepaliveTimeoutMax       uint32
+	MaxHandshakeAttemptsMin   uint32
+	MaxHandshakeAttemptsMax   uint32
+	ContentPaddingAdditionMin uint32
+	ContentPaddingAdditionMax uint32
+	HeaderProtectionKey       []byte
+}
+
+var Store StoreStruct
+
+func init() {
+	Store = StoreStruct{
+		Jc:                  getI32FromEnv(envAmneziaJc),
+		Jmin:                getI32FromEnv(envAmneziaJmin),
+		Jmax:                getI32FromEnv(envAmneziaJmax),
+		S1:                  getI32FromEnv(envAmneziaS1),
+		S2:                  getI32FromEnv(envAmneziaS2),
+		S3:                  getU32FromEnv(envAmneziaS3),
+		S4:                  getU32FromEnv(envAmneziaS4),
+		I1:                  getStrFromEnv(envAmneziaI1),
+		I2:                  getStrFromEnv(envAmneziaI2),
+		I3:                  getStrFromEnv(envAmneziaI3),
+		I4:                  getStrFromEnv(envAmneziaI4),
+		I5:                  getStrFromEnv(envAmneziaI5),
+		HeaderProtectionKey: getKeyFromEnv(envAmneziaHeaderProtectionKey),
+	}
+
+	Store.H1Min, Store.H1Max = getU32RangeFromEnv(envAmneziaH1)
+	Store.H2Min, Store.H2Max = getU32RangeFromEnv(envAmneziaH2)
+	Store.H3Min, Store.H3Max = getU32RangeFromEnv(envAmneziaH3)
+	Store.H4Min, Store.H4Max = getU32RangeFromEnv(envAmneziaH4)
+	Store.RekeyAfterTimeMin, Store.RekeyAfterTimeMax = getU32RangeFromEnv(envAmneziaRekeyAfterTime)
+	Store.RekeyTimeoutMin, Store.RekeyTimeoutMax = getU32RangeFromEnv(envAmneziaRekeyTimeout)
+	Store.RejectAfterTimeMin, Store.RejectAfterTimeMax = getU32RangeFromEnv(envAmneziaRejectAfterTime)
+	Store.KeepaliveTimeoutMin, Store.KeepaliveTimeoutMax = getU32RangeFromEnv(envAmneziaKeepaliveTimeout)
+	Store.MaxHandshakeAttemptsMin, Store.MaxHandshakeAttemptsMax = getU32RangeFromEnv(envAmneziaMaxHandshakeAttempts)
+	Store.ContentPaddingAdditionMin, Store.ContentPaddingAdditionMax = getU32RangeFromEnv(envAmneziaContentPaddingAddition)
+}
+
+func parseI64OrZero(strval string) int64 {
+	val, err := strconv.ParseInt(strval, 10, 32)
+	if err != nil {
+		return 0
+	}
+	return val
+}
+
+func getI64FromEnv(name string) int64 {
+	val, ok := os.LookupEnv(name)
+	if !ok {
+		return 0
+	}
+	return parseI64OrZero(val)
+}
+
+func getI32FromEnv(name string) int32 {
+	return int32(getI64FromEnv(name))
+}
+
+func getU32FromEnv(name string) uint32 {
+	return uint32(getI64FromEnv(name))
+}
+
+func getStrFromEnv(name string) string {
+	val, ok := os.LookupEnv(name)
+	if !ok {
+		return ""
+	}
+	return val
+}
+
+func getKeyFromEnv(name string) []byte {
+	b64 := getStrFromEnv(name)
+	if b64 == "" {
+		return []byte{}
+	}
+	val, err := base64.StdEncoding.DecodeString(b64)
+	if err != nil {
+		return []byte{}
+	}
+	if len(val) != 32 {
+		return []byte{}
+	}
+	return val
+}
+
+func getI64RangeFromEnv(name string) (int64, int64) {
+	val, ok := os.LookupEnv(name)
+	if !ok {
+		return 0, 0
+	}
+	left, right, found := strings.Cut(val, "-")
+
+	if found {
+		return parseI64OrZero(left), parseI64OrZero(right)
+	} else {
+		return parseI64OrZero(left), parseI64OrZero(left)
+	}
+}
+
+func getU32RangeFromEnv(name string) (uint32, uint32) {
+	left, right := getI64RangeFromEnv(name)
+	return uint32(left), uint32(right)
+}
