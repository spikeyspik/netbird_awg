+		sb.WriteString(fmt.Sprintf("s3=%d\n", val))
+	}
+	if val := conf.GetS4(); val > 0 {
+		sb.WriteString(fmt.Sprintf("s4=%d\n", val))
+	}
+	if min, max := conf.GetH1(); min > 0 {
