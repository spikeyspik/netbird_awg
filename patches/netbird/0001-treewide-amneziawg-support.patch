+func useLegacyAmneziaConfigField(peerVersion string) bool {
+	if peerVersion == "" || peerVersion == "development" {
+		return false
+	}
+
+	v, err := version.NewVersion(baseNetbirdVersion(peerVersion))
+	if err != nil {
+		return false
+	}
+
+	return precomputedAmneziaConfigLegacyConstraint.Check(v)
+}
+
+func baseNetbirdVersion(peerVersion string) string {
+	peerVersion = strings.TrimPrefix(strings.TrimSpace(peerVersion), "v")
+	if before, _, ok := strings.Cut(peerVersion, "-"); ok {
+		return before
+	}
+	return peerVersion
+}
