+++ b/client/internal/amneziawg/amneziawg.go
@@ -0,0 +1,201 @@
+package amneziawg
+
+import (
+	mgmProto "github.com/netbirdio/netbird/shared/management/proto"
+	"google.golang.org/protobuf/proto"
+)
+
+// AmneziaConfig describes AmneziaWG obfuscation parameters.
+// If nil or all fields are zero, it behaves as standard WireGuard.
+type AmneziaConfig struct {
+	Jc                        int32
+	Jmin                      int32
+	Jmax                      int32
+	S1                        int32
+	S2                        int32
+	S3                        uint32
+	S4                        uint32
+	H1Min                     uint32
+	H1Max                     uint32
+	H2Min                     uint32
+	H2Max                     uint32
+	H3Min                     uint32
+	H3Max                     uint32
+	H4Min                     uint32
+	H4Max                     uint32
+	I1                        string
+	I2                        string
+	I3                        string
+	I4                        string
+	I5                        string
+	RekeyAfterTimeMin         uint32
+	RekeyAfterTimeMax         uint32
+	RekeyTimeoutMin           uint32
+	RekeyTimeoutMax           uint32
+	RejectAfterTimeMin        uint32
+	RejectAfterTimeMax        uint32
+	KeepaliveTimeoutMin       uint32
+	KeepaliveTimeoutMax       uint32
+	MaxHandshakeAttemptsMin   uint32
+	MaxHandshakeAttemptsMax   uint32
+	ContentPaddingAdditionMin uint32
+	ContentPaddingAdditionMax uint32
+	HeaderProtectionKey       [32]byte
+}
+
+func (cfg AmneziaConfig) IsEmpty() bool {
+
+	return cfg.Jc == 0 &&
+		cfg.Jmin == 0 &&
+		cfg.Jmax == 0 &&
+		cfg.S1 == 0 &&
+		cfg.S2 == 0 &&
+		cfg.S3 == 0 &&
+		cfg.S4 == 0 &&
+		cfg.H1Min == 0 &&
+		cfg.H1Max == 0 &&
+		cfg.H2Min == 0 &&
+		cfg.H2Max == 0 &&
+		cfg.H3Min == 0 &&
+		cfg.H3Max == 0 &&
+		cfg.H4Min == 0 &&
+		cfg.H4Max == 0 &&
+		cfg.I1 == "" &&
+		cfg.I2 == "" &&
+		cfg.I3 == "" &&
+		cfg.I4 == "" &&
+		cfg.I5 == "" &&
+		cfg.RekeyAfterTimeMin == 0 &&
+		cfg.RekeyAfterTimeMax == 0 &&
+		cfg.RekeyTimeoutMin == 0 &&
+		cfg.RekeyTimeoutMax == 0 &&
+		cfg.RejectAfterTimeMin == 0 &&
+		cfg.RejectAfterTimeMax == 0 &&
+		cfg.KeepaliveTimeoutMin == 0 &&
+		cfg.KeepaliveTimeoutMax == 0 &&
+		cfg.MaxHandshakeAttemptsMin == 0 &&
+		cfg.MaxHandshakeAttemptsMax == 0 &&
+		cfg.ContentPaddingAdditionMin == 0 &&
+		cfg.ContentPaddingAdditionMax == 0 &&
+		cfg.HeaderProtectionKey == [32]byte{}
+}
+func (cfg AmneziaConfig) GetJc() int32            { return cfg.Jc }
+func (cfg AmneziaConfig) GetJmin() int32          { return cfg.Jmin }
+func (cfg AmneziaConfig) GetJmax() int32          { return cfg.Jmax }
+func (cfg AmneziaConfig) GetS1() int32            { return cfg.S1 }
+func (cfg AmneziaConfig) GetS2() int32            { return cfg.S2 }
+func (cfg AmneziaConfig) GetS3() uint32           { return cfg.S3 }
+func (cfg AmneziaConfig) GetS4() uint32           { return cfg.S4 }
+func (cfg AmneziaConfig) GetH1() (uint32, uint32) { return cfg.H1Min, cfg.H1Max }
+func (cfg AmneziaConfig) GetH2() (uint32, uint32) { return cfg.H2Min, cfg.H2Max }
+func (cfg AmneziaConfig) GetH3() (uint32, uint32) { return cfg.H3Min, cfg.H3Max }
+func (cfg AmneziaConfig) GetH4() (uint32, uint32) { return cfg.H4Min, cfg.H4Max }
+func (cfg AmneziaConfig) GetI1() string           { return cfg.I1 }
+func (cfg AmneziaConfig) GetI2() string           { return cfg.I2 }
+func (cfg AmneziaConfig) GetI3() string           { return cfg.I3 }
+func (cfg AmneziaConfig) GetI4() string           { return cfg.I4 }
+func (cfg AmneziaConfig) GetI5() string           { return cfg.I5 }
+func (cfg AmneziaConfig) GetRekeyAfterTime() (uint32, uint32) {
+	return cfg.RekeyAfterTimeMin, cfg.RekeyAfterTimeMax
+}
+func (cfg AmneziaConfig) GetRekeyTimeout() (uint32, uint32) {
+	return cfg.RekeyTimeoutMin, cfg.RekeyTimeoutMax
+}
+func (cfg AmneziaConfig) GetRejectAfterTime() (uint32, uint32) {
+	return cfg.RejectAfterTimeMin, cfg.RejectAfterTimeMax
+}
+func (cfg AmneziaConfig) GetKeepaliveTimeout() (uint32, uint32) {
+	return cfg.KeepaliveTimeoutMin, cfg.KeepaliveTimeoutMax
+}
+func (cfg AmneziaConfig) GetMaxHandshakeAttempts() (uint32, uint32) {
+	return cfg.MaxHandshakeAttemptsMin, cfg.MaxHandshakeAttemptsMax
+}
+func (cfg AmneziaConfig) GetContentPaddingAddition() (uint32, uint32) {
+	return cfg.ContentPaddingAdditionMin, cfg.ContentPaddingAdditionMax
+}
+func (cfg AmneziaConfig) GetHeaderProtectionKey() [32]byte {
+	return cfg.HeaderProtectionKey
+}
+
+func FromPeerConfig(peerConfig *mgmProto.PeerConfig) AmneziaConfig {
+	if peerConfig == nil {
+		return AmneziaConfig{}
+	}
+
+	if legacyConfig, ok := fromLegacyField9(peerConfig.GetAddressV6()); ok {
+		return legacyConfig
+	}
+
+	return FromProtobuf(peerConfig.GetAmneziaConfig())
+}
+
+func FromProtobuf(config *mgmProto.AmneziaConfig) AmneziaConfig {
+	if config == nil {
+		return AmneziaConfig{}
+	}
+
+	return AmneziaConfig{
+		Jc:                        config.GetJc(),
+		Jmin:                      config.GetJmin(),
+		Jmax:                      config.GetJmax(),
+		S1:                        config.GetS1(),
+		S2:                        config.GetS2(),
+		S3:                        config.GetS3(),
+		S4:                        config.GetS4(),
+		H1Min:                     config.GetH1Min(),
+		H1Max:                     config.GetH1Max(),
+		H2Min:                     config.GetH2Min(),
+		H2Max:                     config.GetH2Max(),
+		H3Min:                     config.GetH3Min(),
+		H3Max:                     config.GetH3Max(),
+		H4Min:                     config.GetH4Min(),
+		H4Max:                     config.GetH4Max(),
+		I1:                        config.GetI1(),
+		I2:                        config.GetI2(),
+		I3:                        config.GetI3(),
+		I4:                        config.GetI4(),
+		I5:                        config.GetI5(),
+		RekeyAfterTimeMin:         config.GetRekeyAfterTimeMin(),
+		RekeyAfterTimeMax:         config.GetRekeyAfterTimeMax(),
+		RekeyTimeoutMin:           config.GetRekeyTimeoutMin(),
+		RekeyTimeoutMax:           config.GetRekeyTimeoutMax(),
+		RejectAfterTimeMin:        config.GetRejectAfterTimeMin(),
+		RejectAfterTimeMax:        config.GetRejectAfterTimeMax(),
+		KeepaliveTimeoutMin:       config.GetKeepaliveTimeoutMin(),
+		KeepaliveTimeoutMax:       config.GetKeepaliveTimeoutMax(),
+		MaxHandshakeAttemptsMin:   config.GetMaxHandshakeAttemptsMin(),
+		MaxHandshakeAttemptsMax:   config.GetMaxHandshakeAttemptsMax(),
+		ContentPaddingAdditionMin: config.GetContentPaddingAdditionMin(),
+		ContentPaddingAdditionMax: config.GetContentPaddingAdditionMax(),
+		HeaderProtectionKey:       getHeaderProtectionKey(config),
+	}
+}
+
+func getHeaderProtectionKey(config *mgmProto.AmneziaConfig) [32]byte {
+	key := config.GetHeaderProtectionKey()
+	if len(key) == 0 {
+		return [32]byte{}
+	}
+	if len(key) != 32 {
+		panic("Malformed header protection key")
+	}
+	return ([32]byte)(key)
+}
+
+func fromLegacyField9(raw []byte) (AmneziaConfig, bool) {
+	if len(raw) == 0 {
+		return AmneziaConfig{}, false
+	}
+
+	var legacy mgmProto.AmneziaConfig
+	if err := proto.Unmarshal(raw, &legacy); err != nil {
+		return AmneziaConfig{}, false
+	}
+
+	cfg := FromProtobuf(&legacy)
+	if cfg.IsEmpty() {
+		return AmneziaConfig{}, false
+	}
+
+	return cfg, true
+}
