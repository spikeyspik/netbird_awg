+	if min, max := conf.GetRekeyTimeout(); min > 0 {
+		if max == 0 {
+			max = min
+		}
+		sb.WriteString(fmt.Sprintf("rekey_timeout=%d-%d\n", min, max))
+	}
+	if min, max := conf.GetRejectAfterTime(); min > 0 {
+		if max == 0 {
+			max = min
+		}
+		sb.WriteString(fmt.Sprintf("reject_after_time=%d-%d\n", min, max))
+	}
+	if min, max := conf.GetKeepaliveTimeout(); min > 0 {
+		if max == 0 {
+			max = min
+		}
+		sb.WriteString(fmt.Sprintf("keepalive_timeout=%d-%d\n", min, max))
+	}
+	if min, max := conf.GetMaxHandshakeAttempts(); min > 0 {
+		if max == 0 {
+			max = min
+		}
+		sb.WriteString(fmt.Sprintf("max_handshake_attempts=%d-%d\n", min, max))
+	}
+	if min, max := conf.GetContentPaddingAddition(); min > 0 {
+		if max == 0 {
+			max = min
+		}
+		sb.WriteString(fmt.Sprintf("content_padding_addition=%d-%d\n", min, max))
+	}
+	if val := conf.GetHeaderProtectionKey(); len(val) != 0 {
+		sb.WriteString(fmt.Sprintf("header_protection_key=%s\n", hex.EncodeToString(val[:])))
+	}
+}
