+
+// AmneziaConfig contains AmneziaWG obfuscation parameters.
+// If not set or all fields are default/zero, standard WireGuard will be used.
+message AmneziaConfig {
+  // Junk packet count
+  optional int32 jc = 1;
+  // Junk packet minimum size
+  optional int32 jmin = 2;
+  // Junk packet maximum size
+  optional int32 jmax = 3;
+  // Init packet junk size
+  optional int32 s1 = 4;
+  // Response packet junk size
+  optional int32 s2 = 5;
+  // Init packet magic header 1
+  optional uint32 h1_min = 6;
+  // Init packet magic header 2
+  optional uint32 h2_min = 7;
+  // Init packet magic header 3
+  optional uint32 h3_min = 8;
+  // Init packet magic header 4
+  optional uint32 h4_min = 9;
+  // Init packet magic string 1
+  optional string i1 = 10;
+  // Init packet magic string 2
+  optional string i2 = 11;
+  // Init packet magic string 3
+  optional string i3 = 12;
+  // Init packet magic string 4
+  optional string i4 = 13;
+  // Init packet magic string 5
+  optional string i5 = 14;
+
+  // H1-H4 range support
+  optional uint32 h1_max = 15;
+  optional uint32 h2_max = 16;
+  optional uint32 h3_max = 17;
+  optional uint32 h4_max = 18;
+
+  // Cookie packet junk size
+  optional uint32 s3 = 19;
+  // Transport message junk size
+  optional uint32 s4 = 20;
+
+  // AWG3 timing obfuscation
+  // These are all actually uint16
+  optional uint32 rekey_after_time_min = 21;
+  optional uint32 rekey_after_time_max = 22;
+  optional uint32 rekey_timeout_min = 23;
+  optional uint32 rekey_timeout_max = 24;
+  optional uint32 reject_after_time_min = 25;
+  optional uint32 reject_after_time_max = 26;
+  optional uint32 keepalive_timeout_min = 27;
+  optional uint32 keepalive_timeout_max = 28;
+  optional uint32 max_handshake_attempts_min = 29;
+  optional uint32 max_handshake_attempts_max = 30;
+  // keepalive not used with lazy connections
+
+  // AWG3 content padding
+  // These are also actually uint16
+  optional uint32 content_padding_addition_min = 31;
+  optional uint32 content_padding_addition_max = 32;
+
+  // AWG3 header protection
+  optional bytes header_protection_key = 33;
+}
